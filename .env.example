# ─── Frontend (Vite / Vercel) ──────────────────────────────────────────
# Set this to your Render backend URL in your Vercel project environment variables.
# For local development, use http://localhost:8000
VITE_API_URL=https://your-render-app.onrender.com

# ─── Backend (Python / Render) ─────────────────────────────────────────
# Comma-separated list of allowed CORS origins (your Vercel frontend domain).
# Include localhost for local development.
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Google Gemini API key for AI advisory generation.
# Optional — if not set, the backend uses built-in bilingual fallback recommendations.
# NEVER expose this in frontend code or commit it to git.
GEMINI_API_KEY=
